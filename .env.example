FIREBASE_PROJECT_ID=your-firebase-project-id
FRONTEND_URL=https://your-vercel-domain.vercel.app
PORT=8080

# Public Firebase web configuration. These values are safe to expose in the browser.
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
FIREBASE_WEB_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_WEB_APP_ID=your-web-app-id
VITE_API_URL=https://your-cloud-run-service.run.app